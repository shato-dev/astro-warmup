---
// Search box shown in the site header on every page.
// Nothing happens in this frontmatter at runtime — all the work is in the
// <script> below, which is bundled into dist/ and runs in the visitor's
// browser each time they type.
---

<div class="search">
  <label class="visually-hidden" for="search-input">記事を検索</label>
  <input
    type="search"
    id="search-input"
    placeholder="記事を検索…"
    autocomplete="off"
  />
  <ul id="search-results" class="search-results" hidden></ul>
</div>

<script>
  type Entry = {
    title: string;
    description: string;
    body: string;
    url: string;
    tags: string[];
  };

  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const results = document.querySelector<HTMLUListElement>('#search-results')!;

  // BASE_URL is "/" in dev and "/astro-warmup" on GitHub Pages. Strip any
  // trailing slash and add our own so both cases produce a valid path.
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const searchJsonUrl = `${base}/search.json`;

  let entries: Entry[] = [];
  let loaded = false;

  // Fetch the index once, on the first keystroke (not on page load).
  async function loadIndex() {
    if (loaded) return;
    const res = await fetch(searchJsonUrl);
    entries = await res.json();
    loaded = true;
  }

  function render(matches: Entry[], hasQuery: boolean) {
    if (!hasQuery) {
      results.hidden = true;
      results.replaceChildren();
      return;
    }

    results.hidden = false;

    if (matches.length === 0) {
      const li = document.createElement('li');
      li.className = 'search-empty';
      li.textContent = '一致する記事がありません';
      results.replaceChildren(li);
      return;
    }

    // Build nodes with the DOM API and set text via textContent. Never splice
    // data into an innerHTML string — that is how XSS bugs start.
    results.replaceChildren(
      ...matches.map((entry) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = entry.url;
        a.textContent = entry.title;
        li.append(a);
        return li;
      }),
    );
  }

  input.addEventListener('input', async () => {
    await loadIndex();

    const query = input.value.trim().toLowerCase();
    const matches = query
      ? entries.filter(
          (entry) =>
            entry.title.toLowerCase().includes(query) ||
            entry.body.toLowerCase().includes(query),
        )
      : [];

    render(matches, query.length > 0);
  });
</script>

<style>
  .search {
    position: relative;
    margin-left: auto;
  }
  #search-input {
    padding: 0.3rem 0.6rem;
    font-size: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
  }
  .search-results {
    position: absolute;
    right: 0;
    z-index: 10;
    margin: 0.3rem 0 0;
    padding: 0.3rem 0;
    list-style: none;
    min-width: 16rem;
    max-width: 22rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
  }
  .search-results li {
    padding: 0.35rem 0.8rem;
    font-size: 0.9rem;
  }
  .search-results li a {
    text-decoration: none;
  }
  .search-empty {
    color: var(--muted);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
