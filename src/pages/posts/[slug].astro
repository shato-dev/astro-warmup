---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, href } from '../../lib/posts';

// getStaticPaths: because this is a static site, we must list every URL
// this [slug] file should produce at build time. One entry per post.
// Drafts are included here so you can still preview them by direct URL.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post); // Markdown body -> renderable component
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <p class="post-tags">
      {post.data.tags.map((tag) => <a class="tag" href={href(`/tags/${tag}`)}>#{tag}</a>)}
    </p>
    {post.data.draft && <p class="draft-note">（この記事は下書きです）</p>}

    <div class="post-body">
      <Content />
    </div>

    <p><a href={href('/')}>← 記事一覧へ</a></p>
  </article>
</BaseLayout>

<style>
  .post-tags {
    margin: 0.5rem 0 1.5rem;
  }
  .draft-note {
    color: var(--muted);
    font-style: italic;
  }
  .post-body :global(h2) {
    margin-top: 2rem;
  }
  .post-body :global(pre) {
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
  }
  .post-body :global(table) {
    border-collapse: collapse;
  }
  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid var(--border);
    padding: 0.3rem 0.6rem;
  }
</style>
